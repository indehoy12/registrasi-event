# Salin file ini menjadi .env lalu isi (hanya untuk npm run dev / build di komputer sendiri)
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_STORAGE_BUCKET=
VITE_FB_APP_ID=

# Khusus Netlify Function (netlify dev). Di Netlify isi lewat Environment variables, bukan file.
FONNTE_TOKEN=
FB_API_KEY=
FB_PROJECT_ID=
SITE_URL=

# Email tiket (Gmail). Isi di Netlify > Environment variables.
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=
# Opsional: false = WhatsApp selalu teks + tautan (tanpa lampiran gambar)
WA_KIRIM_GAMBAR=
